# PatchPilot Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# === LLM API Keys ===
# Anthropic Claude API key (for core reasoning agents)
ANTHROPIC_API_KEY=

# Google Gemini API key (for lower-stakes tasks)
GOOGLE_API_KEY=

# === GitHub ===
# GitHub personal access token (for repo access and PR creation)
GITHUB_TOKEN=

# === Model Configuration ===
# Default Anthropic model for high-stakes reasoning
DEFAULT_OPUS_MODEL=claude-sonnet-4-20250514

# Default Google model for scaffolding tasks
DEFAULT_GEMINI_MODEL=gemini-2.0-flash

# === Vector Database ===
# Directory for ChromaDB persistent storage
CHROMA_PERSIST_DIR=./chroma_data

# Sentence-transformer model for code embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# === Sandbox ===
# Max retry attempts for test failure loop
MAX_RETRIES=3

# Timeout for sandbox test execution (seconds)
SANDBOX_TIMEOUT=300

# Sandbox mode: 'docker' or 'subprocess'
SANDBOX_MODE=subprocess

# === Observability ===
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Directory for agent trace files
TRACE_DIR=./traces
